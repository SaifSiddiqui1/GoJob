    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    role: 'Software Engineer', // Replace with actual Gemini parsing logic \n    company: 'Meta', // Example payload matching your spec\n    salary: '₹12 LPA',\n    category: 'Frontend',\n    location: 'Remote',\n    description: $json.description,\n    apply_link: $json.apply_link\n  }\n}];"
      },
      "id": "7",
      "name": "AI Parse & Classify (Gemini Placeholders)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [ 1380, 200 ]
    },
    {
      "parameters": {
        "jsCode": "const salary = $json.salary || '';\n\nfunction normalizeSalary(s) {\n  let lower = s.toLowerCase();\n  if (lower.includes('lpa')) return parseFloat(lower) * 100000;\n  if (lower.includes('$')) return parseFloat(lower.replace('$', '')) * 83 * 12;\n  if (lower.includes('month')) return parseFloat(lower) * 12;\n  return null;\n}\n\nreturn [{\n  json: { ...$json, salary_normalized: normalizeSalary(salary) }\n}];"
      },
      "id": "8",
      "name": "Normalize Salary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [ 1580, 200 ]
    },
    {
      "parameters": {
        "collection": "jobs",
        "operation": "find",
        "query": "={\n  \"apply_link\": \"{{$json.apply_link}}\"\n}"
      },
      "id": "9",
      "name": "MongoDB Look for Duplicate",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [ 1780, 200 ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length}}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "10",
      "name": "If Is Unique",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 1980, 200 ]
    },
    {
      "parameters": {
        "jsCode": "const trustedCompanies = ['Google', 'Microsoft', 'Amazon', 'Meta', 'Infosys', 'TCS'];\nconst autoApprove = trustedCompanies.includes($json.company);\nreturn [{\n  json: {\n    ...$json,\n    status: autoApprove ? 'approved' : 'pending',\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "11",
      "name": "Auto Approval Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [ 2180, 180 ]
    },
