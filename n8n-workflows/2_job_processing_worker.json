            {
              "value1": "={{$json.apply_link}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "5",
      "name": "Ensure Has Link",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 980, 220 ]
    },
