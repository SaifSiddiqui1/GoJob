    {
      "parameters": {
        "jsCode": "const message = JSON.parse($json.value);\n// Regex to find a URL in text\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\nconst links = message.text ? message.text.match(urlRegex) : [];\nconst apply_link = links && links.length > 0 ? links[0] : null;\nreturn [{\n  json: {\n    ...message,\n    apply_link,\n    description: message.text\n  }\n}];"
      },
      "id": "4",
      "name": "Extract Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [ 780, 220 ]
    },
    {
